{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/k2c?route=:route*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
